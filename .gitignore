# --- Datos sensibles (NO subir) ---------------------------------------
# Insumos reales en Data/ (personas, demanda, staff). Se ignora todo el
# contenido de la carpeta pero se conserva la carpeta (vía .gitkeep) para que
# quien clone sepa dónde dejar los Excel.
Data/*
!Data/.gitkeep
# Por si algún Excel se deja fuera de Data/ por error:
*.xlsx
*.xls
# Golden set generado: contiene códigos y nombres reales. Es reproducible
# ejecutando el pipeline sobre los Excel, así que no se versiona.
golden_set/

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# --- SO / editor -------------------------------------------------------
.DS_Store
.idea/
.vscode/
